<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_SmeOnboarding"
                  targetNamespace="http://kilimabank.example/bpmn"
                  exporter="Camunda Modeler" exporterVersion="5.40.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">

  <bpmn:process id="sme-onboarding" name="SME account onboarding" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0.0" />
    </bpmn:extensionElements>

    <bpmn:startEvent id="StartEvent_ApplicationSubmitted" name="Application submitted">
      <bpmn:outgoing>Flow_ToCountry</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ApplicationSubmitted" messageRef="Message_ApplicationSubmitted" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToCountry" sourceRef="StartEvent_ApplicationSubmitted" targetRef="Gateway_Country" />

    <bpmn:exclusiveGateway id="Gateway_Country" name="Country?" default="Flow_Country_Other">
      <bpmn:incoming>Flow_ToCountry</bpmn:incoming>
      <bpmn:outgoing>Flow_Country_KE</bpmn:outgoing>
      <bpmn:outgoing>Flow_Country_Other</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Country_KE" name="Kenya" sourceRef="Gateway_Country" targetRef="Task_RegistryLookup">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=country = "KE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Country_Other" name="Tanzania / Uganda" sourceRef="Gateway_Country" targetRef="Gateway_JoinManualCheck" />

    <bpmn:serviceTask id="Task_RegistryLookup" name="Look up business registry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="registry-lookup" retries="5" />
        <zeebe:ioMapping>
          <zeebe:input source="=registrationNumber" target="registrationNumber" />
          <zeebe:output source="=registryVerified" target="registryVerified" />
          <zeebe:output source="=registryStatus" target="registryStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Country_KE</bpmn:incoming>
      <bpmn:outgoing>Flow_RegistryLookupDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_RegistryNotFound" name="Not found in registry" attachedToRef="Task_RegistryLookup">
      <bpmn:outgoing>Flow_NotFoundToManual</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_RegistryNotFound" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_NotFoundToManual" sourceRef="Boundary_RegistryNotFound" targetRef="Gateway_JoinManualCheck" />
    <bpmn:exclusiveGateway id="Gateway_JoinManualCheck">
      <bpmn:incoming>Flow_Country_Other</bpmn:incoming>
      <bpmn:incoming>Flow_NotFoundToManual</bpmn:incoming>
      <bpmn:outgoing>Flow_ToManualCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToManualCheck" sourceRef="Gateway_JoinManualCheck" targetRef="Task_ManualRegistryCheck" />

    <bpmn:userTask id="Task_ManualRegistryCheck" name="Check registry manually">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="manual-registry-check" />
        <zeebe:assignmentDefinition candidateGroups="=[&#34;branch-ops-&#34; + lower case(country)]" />
        <zeebe:ioMapping>
          <zeebe:input source="=registrationNumber" target="registrationNumber" />
          <zeebe:input source="=businessName" target="businessName" />
          <zeebe:output source="=registryVerified" target="registryVerified" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToManualCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualCheckDone</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_RegistryLookupDone" sourceRef="Task_RegistryLookup" targetRef="Gateway_JoinRegistry" />
    <bpmn:sequenceFlow id="Flow_ManualCheckDone" sourceRef="Task_ManualRegistryCheck" targetRef="Gateway_JoinRegistry" />
    <bpmn:exclusiveGateway id="Gateway_JoinRegistry">
      <bpmn:incoming>Flow_RegistryLookupDone</bpmn:incoming>
      <bpmn:incoming>Flow_ManualCheckDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRegistryDecision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToRegistryDecision" sourceRef="Gateway_JoinRegistry" targetRef="Gateway_RegistryVerified" />

    <bpmn:exclusiveGateway id="Gateway_RegistryVerified" name="Registry confirmed?" default="Flow_RegistryNo">
      <bpmn:incoming>Flow_ToRegistryDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_RegistryYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_RegistryNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_RegistryYes" name="Yes" sourceRef="Gateway_RegistryVerified" targetRef="Task_RequestScreening">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=registryVerified = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RegistryNo" name="No" sourceRef="Gateway_RegistryVerified" targetRef="Gateway_JoinRejection" />

    <bpmn:serviceTask id="Task_RequestScreening" name="Request sanctions &amp; PEP screening">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="screening-request" retries="5" />
        <zeebe:ioMapping>
          <zeebe:input source="=applicationId" target="applicationId" />
          <zeebe:output source="=screeningRequestId" target="screeningRequestId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RegistryYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAwaitScreening</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAwaitScreening" sourceRef="Task_RequestScreening" targetRef="Task_AwaitScreening" />

    <bpmn:receiveTask id="Task_AwaitScreening" name="Wait for screening result" messageRef="Message_ScreeningCompleted">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=screeningMatch" target="screeningMatch" />
          <zeebe:output source="=screeningReference" target="screeningReference" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAwaitScreening</bpmn:incoming>
      <bpmn:outgoing>Flow_ScreeningReceived</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_ScreeningOverdue" name="26 hours" attachedToRef="Task_AwaitScreening">
      <bpmn:outgoing>Flow_ToChaseScreening</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT26H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ToChaseScreening" sourceRef="Boundary_ScreeningOverdue" targetRef="Task_ChaseScreening" />

    <bpmn:userTask id="Task_ChaseScreening" name="Chase overdue screening result">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="chase-screening" />
        <zeebe:assignmentDefinition candidateGroups="compliance-ops" />
        <zeebe:ioMapping>
          <zeebe:input source="=screeningRequestId" target="screeningRequestId" />
          <zeebe:output source="=screeningMatch" target="screeningMatch" />
          <zeebe:output source="=screeningReference" target="screeningReference" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToChaseScreening</bpmn:incoming>
      <bpmn:outgoing>Flow_ChaseDone</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_ScreeningReceived" sourceRef="Task_AwaitScreening" targetRef="Gateway_JoinScreening" />
    <bpmn:sequenceFlow id="Flow_ChaseDone" sourceRef="Task_ChaseScreening" targetRef="Gateway_JoinScreening" />
    <bpmn:exclusiveGateway id="Gateway_JoinScreening">
      <bpmn:incoming>Flow_ScreeningReceived</bpmn:incoming>
      <bpmn:incoming>Flow_ChaseDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDueDiligence</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToDueDiligence" sourceRef="Gateway_JoinScreening" targetRef="Task_DueDiligence" />

    <bpmn:businessRuleTask id="Task_DueDiligence" name="Determine due diligence level">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="due-diligence-level" resultVariable="dueDiligenceLevel" />
        <zeebe:ioMapping>
          <zeebe:input source="=screeningMatch" target="screeningMatch" />
          <zeebe:input source="=country" target="country" />
          <zeebe:input source="=legalForm" target="legalForm" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDueDiligence</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnhancedGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_ToEnhancedGateway" sourceRef="Task_DueDiligence" targetRef="Gateway_Enhanced" />

    <bpmn:exclusiveGateway id="Gateway_Enhanced" name="Due diligence level?" default="Flow_NotEnhanced">
      <bpmn:incoming>Flow_ToEnhancedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Enhanced</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotEnhanced</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Enhanced" name="Enhanced" sourceRef="Gateway_Enhanced" targetRef="Task_ComplianceReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=dueDiligenceLevel = "enhanced"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotEnhanced" name="Simplified / standard" sourceRef="Gateway_Enhanced" targetRef="Gateway_JoinToCore" />

    <bpmn:userTask id="Task_ComplianceReview" name="Review application due diligence">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="compliance-review" />
        <zeebe:assignmentDefinition candidateGroups="compliance-officers" />
        <zeebe:ioMapping>
          <zeebe:input source="=applicationId" target="applicationId" />
          <zeebe:input source="=screeningReference" target="screeningReference" />
          <zeebe:output source="=complianceDecision" target="complianceDecision" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Enhanced</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_ReviewOverdue" name="48 hours" cancelActivity="false" attachedToRef="Task_ComplianceReview">
      <bpmn:outgoing>Flow_ToEscalate</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ToEscalate" sourceRef="Boundary_ReviewOverdue" targetRef="Task_EscalateToHead" />
    <bpmn:serviceTask id="Task_EscalateToHead" name="Escalate to Head of Compliance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="compliance-escalation" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=applicationId" target="applicationId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEscalate</bpmn:incoming>
      <bpmn:outgoing>Flow_EscalationDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EscalationDone" sourceRef="Task_EscalateToHead" targetRef="End_Escalated" />
    <bpmn:endEvent id="End_Escalated" name="Escalation sent">
      <bpmn:incoming>Flow_EscalationDone</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ReviewDone" sourceRef="Task_ComplianceReview" targetRef="Gateway_Approved" />
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" default="Flow_Rejected">
      <bpmn:incoming>Flow_ReviewDone</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Approved" name="Yes" sourceRef="Gateway_Approved" targetRef="Gateway_JoinToCore">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=complianceDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="No" sourceRef="Gateway_Approved" targetRef="Gateway_JoinRejection" />

    <bpmn:exclusiveGateway id="Gateway_JoinToCore">
      <bpmn:incoming>Flow_NotEnhanced</bpmn:incoming>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateCustomer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToCreateCustomer" sourceRef="Gateway_JoinToCore" targetRef="Task_CreateCustomer" />

    <bpmn:serviceTask id="Task_CreateCustomer" name="Create customer in core banking">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="core-banking-create-customer" retries="10" />
        <zeebe:ioMapping>
          <zeebe:input source="=applicationId" target="applicationId" />
          <zeebe:input source="=registrationNumber" target="registrationNumber" />
          <zeebe:input source="=businessName" target="businessName" />
          <zeebe:input source="=country" target="country" />
          <zeebe:output source="=customerId" target="customerId" />
          <zeebe:output source="=customerCreatedByProcess" target="customerCreatedByProcess" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreateCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateAccount</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCreateAccount" sourceRef="Task_CreateCustomer" targetRef="Gateway_JoinAccount" />

    <bpmn:exclusiveGateway id="Gateway_JoinAccount">
      <bpmn:incoming>Flow_ToCreateAccount</bpmn:incoming>
      <bpmn:incoming>Flow_RetryAccount</bpmn:incoming>
      <bpmn:incoming>Flow_AccountNotCreated</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAccountTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToAccountTask" sourceRef="Gateway_JoinAccount" targetRef="Task_CreateAccount" />

    <bpmn:serviceTask id="Task_CreateAccount" name="Create account in core banking">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="core-banking-create-account" retries="10" />
        <zeebe:ioMapping>
          <zeebe:input source="=applicationId" target="applicationId" />
          <zeebe:input source="=customerId" target="customerId" />
          <zeebe:input source="=country" target="country" />
          <zeebe:output source="=accountNumber" target="accountNumber" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAccountTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ToJoinWelcome</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Boundary_AccountValidation" name="Account rejected (422)" attachedToRef="Task_CreateAccount">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=accountValidationError" target="accountValidationError" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToResolveValidation</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_AccountValidation" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ToResolveValidation" sourceRef="Boundary_AccountValidation" targetRef="Task_ResolveAccountValidation" />

    <bpmn:userTask id="Task_ResolveAccountValidation" name="Resolve rejected account">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="resolve-rejected-account" />
        <zeebe:assignmentDefinition candidateGroups="core-banking-ops" />
        <zeebe:ioMapping>
          <zeebe:input source="=applicationId" target="applicationId" />
          <zeebe:input source="=customerId" target="customerId" />
          <zeebe:input source="=accountValidationError" target="accountValidationError" />
          <zeebe:input source="=customerCreatedByProcess" target="customerCreatedByProcess" />
          <zeebe:output source="=accountResolution" target="accountResolution" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToResolveValidation</bpmn:incoming>
      <bpmn:outgoing>Flow_ResolutionDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ResolutionDone" sourceRef="Task_ResolveAccountValidation" targetRef="Gateway_Resolution" />
    <bpmn:exclusiveGateway id="Gateway_Resolution" name="Resolution?" default="Flow_CloseCustomer">
      <bpmn:incoming>Flow_ResolutionDone</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryAccount</bpmn:outgoing>
      <bpmn:outgoing>Flow_CloseCustomer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_RetryAccount" name="Data cleanup, retry" sourceRef="Gateway_Resolution" targetRef="Gateway_JoinAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=accountResolution = "RETRY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CloseCustomer" name="Cannot open" sourceRef="Gateway_Resolution" targetRef="Gateway_CustomerOurs" />
    <bpmn:exclusiveGateway id="Gateway_CustomerOurs" name="Customer created by this application?" default="Flow_CustomerOursNo">
      <bpmn:incoming>Flow_CloseCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_CustomerOursYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_CustomerOursNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_CustomerOursYes" name="Yes" sourceRef="Gateway_CustomerOurs" targetRef="Task_CloseCustomer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=customerCreatedByProcess = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CustomerOursNo" name="No, existing customer" sourceRef="Gateway_CustomerOurs" targetRef="Gateway_JoinRejection" />

    <bpmn:userTask id="Task_CloseCustomer" name="Close customer record in core banking">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="close-customer" />
        <zeebe:assignmentDefinition candidateGroups="core-banking-ops" />
        <zeebe:ioMapping>
          <zeebe:input source="=customerId" target="customerId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CustomerOursYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ClosedToRejection</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ClosedToRejection" sourceRef="Task_CloseCustomer" targetRef="Gateway_JoinRejection" />

    <bpmn:boundaryEvent id="Boundary_AccountUnknown" name="Outcome unknown" attachedToRef="Task_CreateAccount">
      <bpmn:outgoing>Flow_ToVerifyAccount</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_AccountOutcomeUnknown" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ToVerifyAccount" sourceRef="Boundary_AccountUnknown" targetRef="Task_VerifyAccount" />
    <bpmn:userTask id="Task_VerifyAccount" name="Check whether account was created">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="verify-account" />
        <zeebe:assignmentDefinition candidateGroups="core-banking-ops" />
        <zeebe:ioMapping>
          <zeebe:input source="=customerId" target="customerId" />
          <zeebe:output source="=accountNumber" target="accountNumber" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToVerifyAccount</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_VerifyDone" sourceRef="Task_VerifyAccount" targetRef="Gateway_AccountFound" />
    <bpmn:exclusiveGateway id="Gateway_AccountFound" name="Account exists?" default="Flow_AccountNotCreated">
      <bpmn:incoming>Flow_VerifyDone</bpmn:incoming>
      <bpmn:outgoing>Flow_AccountFound</bpmn:outgoing>
      <bpmn:outgoing>Flow_AccountNotCreated</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_AccountFound" name="Yes" sourceRef="Gateway_AccountFound" targetRef="Gateway_JoinWelcome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=accountNumber != null and string length(accountNumber) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AccountNotCreated" name="No, retry" sourceRef="Gateway_AccountFound" targetRef="Gateway_JoinAccount" />

    <bpmn:sequenceFlow id="Flow_ToJoinWelcome" sourceRef="Task_CreateAccount" targetRef="Gateway_JoinWelcome" />
    <bpmn:exclusiveGateway id="Gateway_JoinWelcome">
      <bpmn:incoming>Flow_ToJoinWelcome</bpmn:incoming>
      <bpmn:incoming>Flow_AccountFound</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWelcome</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToWelcome" sourceRef="Gateway_JoinWelcome" targetRef="Task_SendWelcome" />

    <bpmn:serviceTask id="Task_SendWelcome" name="Send welcome email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-welcome-email" retries="5" />
        <zeebe:ioMapping>
          <zeebe:input source="=applicationId" target="applicationId" />
          <zeebe:input source="=contactEmail" target="contactEmail" />
          <zeebe:input source="=businessName" target="businessName" />
          <zeebe:input source="=accountNumber" target="accountNumber" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWelcome</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndOpened</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEndOpened" sourceRef="Task_SendWelcome" targetRef="End_AccountOpened" />
    <bpmn:endEvent id="End_AccountOpened" name="Account opened">
      <bpmn:incoming>Flow_ToEndOpened</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_JoinRejection">
      <bpmn:incoming>Flow_RegistryNo</bpmn:incoming>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_ClosedToRejection</bpmn:incoming>
      <bpmn:incoming>Flow_CustomerOursNo</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToSendRejection" sourceRef="Gateway_JoinRejection" targetRef="Task_SendRejection" />
    <bpmn:serviceTask id="Task_SendRejection" name="Send rejection email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-rejection-email" retries="5" />
        <zeebe:ioMapping>
          <zeebe:input source="=applicationId" target="applicationId" />
          <zeebe:input source="=contactEmail" target="contactEmail" />
          <zeebe:input source="=businessName" target="businessName" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSendRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEndRejected" sourceRef="Task_SendRejection" targetRef="End_Rejected" />
    <bpmn:endEvent id="End_Rejected" name="Application rejected">
      <bpmn:incoming>Flow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

